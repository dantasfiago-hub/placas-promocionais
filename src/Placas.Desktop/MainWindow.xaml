<Window x:Class="Placas.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Placas Promocionais" Icon="Assets/placas.ico" Width="1100" Height="720" MinWidth="640" MinHeight="480" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#102C46" Padding="22,16">
      <DockPanel><TextBlock Foreground="#81E2D5" DockPanel.Dock="Right" Text="OFFLINE • Windows" VerticalAlignment="Center"/><TextBlock Text="Placas Promocionais" Foreground="White" FontSize="24" FontWeight="Bold"/></DockPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="Status" Text="Importe os arquivos do VR Master para começar."/></StatusBar>
    <TabControl x:Name="Tabs" Margin="14">
      <TabItem Header="1. Produtos e importação">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,4">
              <TextBlock DockPanel.Dock="Left" Width="130" Text="Importação e dados" Style="{StaticResource GroupLabel}"/>
              <WrapPanel>
                <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Content="Importar XLS / XLSX" Click="ImportClick" ToolTip="Importa planilhas do VR Master (catálogo, ofertas e promoções)"/>
                <Button Content="Cancelar leitura" Click="CancelImportClick"/>
                <Button Content="Relatório da importação" Click="ImportReportClick"/>
                <Button Content="Backup do banco" Click="BackupClick"/>
                <Button Content="Abrir pasta de dados" Click="OpenDataClick"/>
              </WrapPanel>
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
              <TextBlock DockPanel.Dock="Left" Width="130" Text="Buscar e filtrar" Style="{StaticResource GroupLabel}"/>
              <WrapPanel>
                <TextBox x:Name="SearchText" Width="300" ToolTip="Código ou descrição (Enter para pesquisar)" KeyDown="SearchKeyDown"/>
                <ComboBox x:Name="SourceFilter" Width="150" SelectedIndex="0"><ComboBoxItem Content="Todas as origens"/><ComboBoxItem Content="Catálogo"/><ComboBoxItem Content="Ofertas"/><ComboBoxItem Content="Promoções"/></ComboBox>
                <ComboBox x:Name="StatusFilter" Width="160" SelectedIndex="0" SelectionChanged="ProductFilterChanged" ToolTip="Filtrar por situação"><ComboBoxItem Content="Todas as situações"/><ComboBoxItem Content="Não vencidas"/><ComboBoxItem Content="Vencidas"/><ComboBoxItem Content="Requerem atenção"/></ComboBox>
                <ComboBox x:Name="FamilyFilter" Width="170" SelectionChanged="ProductFilterChanged" ToolTip="Filtrar por família"/>
                <Button Content="Pesquisar" Click="SearchClick"/>
              </WrapPanel>
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
              <TextBlock DockPanel.Dock="Left" Width="130" Text="Seleção" Style="{StaticResource GroupLabel}"/>
              <WrapPanel>
                <Button Content="Marcar exibidos" Click="SelectAllClick" ToolTip="Marca todas as linhas exibidas (ou use a caixa do cabeçalho)"/>
                <Button Content="Marcar destacados" Click="MarkHighlightedClick" ToolTip="Marca as linhas destacadas com Ctrl/Shift+clique (a barra de espaço faz o mesmo)"/>
                <Button Content="Desmarcar tudo" Click="ClearSelectionClick"/>
                <TextBlock x:Name="SelectionInfo" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#0F766E" FontWeight="SemiBold" Text="Nenhum item selecionado."/>
              </WrapPanel>
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
              <TextBlock DockPanel.Dock="Left" Width="130" Text="Itens selecionados" Style="{StaticResource GroupLabel}"/>
              <WrapPanel>
                <Button Content="Novo registro" Click="NewProductClick"/>
                <Button x:Name="EditProductButton" Content="Editar" Click="EditProductClick" ToolTip="Edita um item por vez"/>
                <Button x:Name="DeleteProductButton" Style="{StaticResource DangerButton}" Content="Excluir" Click="DeleteProductClick" ToolTip="Exclui todos os itens marcados (ou destacados). Atalho: Delete"/>
                <Button x:Name="ProductImageButton" Content="Imagem do produto…" Click="ProductImageClick" ToolTip="Vincula uma imagem da biblioteca ao produto (vale para catálogo, ofertas e promoções dele)"/>
                <Button x:Name="FamilyImageButton" Content="Imagem da família…" Click="FamilyImageClick" ToolTip="Vincula uma imagem da biblioteca à família dos itens selecionados (vale para todos os produtos dela e para a placa da família)"/>
                <Button x:Name="ConfirmRuleButton" Content="Confirmar regra da promoção" Click="ConfirmRuleClick" ToolTip="Define se o valor da promoção é o total do conjunto ou por unidade, para todas as promoções selecionadas"/>
              </WrapPanel>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock DockPanel.Dock="Left" Width="130" Text="Lote de placas" Style="{StaticResource GroupLabel}"/>
              <WrapPanel>
                <TextBlock Text="Cópias por item:" VerticalAlignment="Center"/>
                <TextBox x:Name="CopiesText" Text="1" Width="55"/>
                <Button x:Name="AddToBatchButton" Style="{StaticResource PrimaryButton}" Content="Adicionar ao lote" Click="AddToBatchClick" ToolTip="Adiciona uma placa por produto selecionado"/>
                <Button x:Name="AddFamiliesButton" Style="{StaticResource PrimaryButton}" Content="Adicionar placas de família" Click="AddFamiliesToBatchClick" ToolTip="Gera uma placa por família (ou grupo de promoção) com a descrição dela. Itens sem família ficam de fora e são listados; os demais entram normalmente."/>
              </WrapPanel>
            </DockPanel>
          </StackPanel>
          <Expander DockPanel.Dock="Bottom" Header="Legenda e dicas" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#526172" Margin="4,6" Text="Marcar ou destacar: as ações valem para os itens marcados (caixa da primeira coluna); se nenhum estiver marcado, valem para as linhas destacadas (Ctrl/Shift+clique). Barra de espaço marca ou desmarca as linhas destacadas; Delete exclui. Busca limitada a 500 condições; os filtros de situação e família atuam sobre esse resultado. Cores: vermelho = vencida, amarelo = regra a confirmar, azul = futura. Passe o mouse sobre a linha para ver arquivo, aba e linha. Clique no cabeçalho para ordenar."/>
          </Expander>
          <DataGrid x:Name="ProductsGrid" SelectionMode="Extended" RowHeight="42" SelectionChanged="ProductsSelectionChanged" PreviewKeyDown="ProductsGridKeyDown">
            <DataGrid.Resources>
              <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/></Style>
              <Style x:Key="RightText" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="TextAlignment" Value="Right"/></Style>
              <Style x:Key="OriginText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Origin}" Value="Oferta"><Setter Property="Foreground" Value="#0B5CAD"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                  <DataTrigger Binding="{Binding Origin}" Value="Promoção"><Setter Property="Foreground" Value="#7A3FB0"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                  <DataTrigger Binding="{Binding Origin}" Value="Catálogo"><Setter Property="Foreground" Value="#526172"/></DataTrigger>
                </Style.Triggers>
              </Style>
              <Style x:Key="SituationText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Level}" Value="expired"><Setter Property="Foreground" Value="#B42318"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="attention"><Setter Property="Foreground" Value="#B54708"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="zero"><Setter Property="Foreground" Value="#B54708"/></DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="future"><Setter Property="Foreground" Value="#175CD3"/></DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="ok"><Setter Property="Foreground" Value="#067647"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Setter Property="ToolTip" Value="{Binding Details}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Level}" Value="expired"><Setter Property="Background" Value="#FBE9E9"/></DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="attention"><Setter Property="Background" Value="#FFF4D6"/></DataTrigger>
                  <DataTrigger Binding="{Binding Level}" Value="future"><Setter Property="Background" Value="#EAF3FF"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="45" SortMemberPath="Selected">
                <DataGridTemplateColumn.Header>
                  <CheckBox HorizontalAlignment="Center" Click="MarkAllHeaderClick" ToolTip="Marcar ou desmarcar todos os exibidos"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Código" Binding="{Binding Item.DisplayCode}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
              <DataGridTemplateColumn Header="Descrição" Width="*" MinWidth="200" SortMemberPath="Item.Description" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel VerticalAlignment="Center" Margin="6,0">
                      <TextBlock Text="{Binding Item.Description}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Item.SubDescription}" FontSize="11" Foreground="#6B7785" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasSub}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Preço (R$)" Binding="{Binding Item.Price, StringFormat=N2}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RightText}"/>
              <DataGridTextColumn Header="Normal (R$)" Binding="{Binding Item.NormalPrice, StringFormat=N2}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RightText}"/>
              <DataGridTextColumn Header="Origem" Binding="{Binding Origin}" Width="85" IsReadOnly="True" ElementStyle="{StaticResource OriginText}"/>
              <DataGridTextColumn Header="Condição" Binding="{Binding Condition}" SortMemberPath="Item.Quantity" Width="160" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="Validade" Binding="{Binding Item.End, StringFormat=dd/MM/yyyy, TargetNullValue='—'}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="Situação" Binding="{Binding Situation}" SortMemberPath="Level" Width="125" IsReadOnly="True" ElementStyle="{StaticResource SituationText}"/>
              <DataGridTextColumn Header="Família" Binding="{Binding FamilyLabel}" SortMemberPath="Item.Family" Width="160" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="Imagem" Binding="{Binding ImageMark}" SortMemberPath="HasImage" Width="80" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="2. Layouts salvos">
        <DockPanel Margin="8">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <WrapPanel DockPanel.Dock="Left">
              <TextBlock Text="Layout:" Style="{StaticResource GroupLabel}"/>
              <ComboBox x:Name="TemplatesBox" Width="240" DisplayMemberPath="Name" SelectionChanged="TemplateChanged"/>
              <Button Content="Novo" Click="NewTemplateClick"/>
              <Button Content="Duplicar" Click="DuplicateTemplateClick"/>
              <Button Style="{StaticResource PrimaryButton}" Content="Salvar layout" Click="SaveTemplateClick"/>
              <Button Style="{StaticResource DangerButton}" Content="Excluir" Click="DeleteTemplateClick"/>
              <Button Content="Exportar JSON" Click="ExportTemplateClick"/>
              <Button Content="Importar JSON" Click="ImportTemplateClick"/>
            </WrapPanel>
            <TextBlock x:Name="PreviewStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#526172" TextTrimming="CharacterEllipsis" Text="Selecione ou crie um layout."/>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="66"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Ferramentas -->
            <Border Grid.Column="0" Background="#F3F5F8" BorderBrush="#D5DBE3" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
              <StackPanel Margin="3">
                <Button Click="AddTextElementClick" Height="54" ToolTip="Adicionar caixa de texto">
                  <StackPanel><TextBlock Text="T" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Texto" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Click="AddFieldElementClick" Height="54" ToolTip="Adicionar um campo do produto (descrição, preço, validade...)">
                  <StackPanel><TextBlock Text="#" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Campo" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Descrição do produto" Tag="descricao" Click="AddFieldItemClick"/>
                      <MenuItem Header="Subdescrição" Tag="subdescricao" Click="AddFieldItemClick"/>
                      <MenuItem Header="Preço" Tag="preco" Click="AddFieldItemClick"/>
                      <MenuItem Header="Preço normal (De ...)" Tag="preco_normal" Click="AddFieldItemClick"/>
                      <MenuItem Header="Validade (até)" Tag="validade" Click="AddFieldItemClick"/>
                      <MenuItem Header="Início da oferta" Tag="inicio" Click="AddFieldItemClick"/>
                      <MenuItem Header="Condição (ex.: 3 unidades por ...)" Tag="condicao" Click="AddFieldItemClick"/>
                      <MenuItem Header="Quantidade" Tag="quantidade" Click="AddFieldItemClick"/>
                      <MenuItem Header="Código" Tag="codigo" Click="AddFieldItemClick"/>
                      <Separator/>
                      <MenuItem Header="Família (código)" Tag="familia" Click="AddFieldItemClick"/>
                      <MenuItem Header="Descrição da família" Tag="descricao_familia" Click="AddFieldItemClick"/>
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
                <Button Click="AddImageElementClick" Height="54" ToolTip="Inserir imagem: do computador, da biblioteca, ou espaço para a imagem do produto ou da família. Imagens ficam ao fundo.">
                  <StackPanel><TextBlock Text="▣" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="Imagem" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Inserir imagem do computador…" Click="InsertImageFromFileClick"/>
                      <MenuItem Header="Escolher imagem da biblioteca…" Click="InsertImageFromLibraryClick"/>
                      <Separator/>
                      <MenuItem Header="Espaço para a imagem do produto" Click="InsertProductImageSlotClick"/>
                      <MenuItem Header="Espaço para a imagem da família" Click="InsertFamilyImageSlotClick"/>
                      <MenuItem Header="Espaço para imagem do produto (ou da família, se não houver)" Click="InsertProductOrFamilySlotClick"/>
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
                <Separator Margin="0,8"/>
                <Button Click="DuplicateElementClick" Height="46" ToolTip="Duplicar o elemento selecionado (Ctrl+D)">
                  <StackPanel><TextBlock Text="⧉" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="Duplicar" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource DangerButton}" Click="DeleteElementClick" Height="46" ToolTip="Excluir o elemento selecionado (Delete)">
                  <StackPanel><TextBlock Text="✕" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="Excluir" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <Grid Grid.Column="1">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Background="#F3F5F8" BorderBrush="#D5DBE3" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="6,3">
                <DockPanel>
                  <TextBlock x:Name="SelectionReadout" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#526172" Margin="8,0,0,0"/>
                  <WrapPanel>
                    <Button x:Name="UndoButton" Content="↶ Desfazer" Click="UndoClick" ToolTip="Desfazer (Ctrl+Z)"/>
                    <Button x:Name="RedoButton" Content="↷ Refazer" Click="RedoClick" ToolTip="Refazer (Ctrl+Y)"/>
                    <Border Width="1" Background="#D5DBE3" Margin="8,3"/>
                    <Button Content="−" Width="30" Click="ZoomOutClick" ToolTip="Diminuir zoom (Ctrl + roda do mouse)"/>
                    <TextBlock x:Name="ZoomText" Text="100%" Width="50" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="+" Width="30" Click="ZoomInClick" ToolTip="Aumentar zoom (Ctrl + roda do mouse)"/>
                    <Button Content="Ajustar" Click="ZoomFitClick" ToolTip="Ajusta a placa à área visível"/>
                    <Button Content="100%" Click="Zoom100Click"/>
                    <CheckBox x:Name="SnapCheck" Content="Ímãs" IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="Alinha às bordas e ao centro da placa e aos outros elementos (mostra guias rosa)"/>
                    <CheckBox x:Name="GridCheck" Content="Grade" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Mostra uma grade de 5 mm" Checked="GridToggled" Unchecked="GridToggled"/>
                  </WrapPanel>
                </DockPanel>
              </Border>
              <ScrollViewer x:Name="DesignScroll" Grid.Row="1" Background="#CBD2DB" Focusable="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="DesignWheel" PreviewKeyDown="DesignKeyDown" SizeChanged="DesignScrollSizeChanged">
                <Border x:Name="PlateBorder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="48" BorderBrush="#7C8794" BorderThickness="1" Background="White">
                  <Border.LayoutTransform><ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/></Border.LayoutTransform>
                  <Grid>
                    <Canvas x:Name="PlateLayer" ClipToBounds="True"/>
                    <Canvas x:Name="OverlayLayer" Background="Transparent" MouseLeftButtonDown="OverlayBackgroundDown"/>
                  </Grid>
                </Border>
              </ScrollViewer>
            </Grid>

            <Border Grid.Column="2" Margin="6,0,0,0" Background="#F3F5F8" BorderBrush="#D5DBE3" BorderThickness="1" CornerRadius="4">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="5"/>
                  <RowDefinition Height="190"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="10">
                    <TextBlock x:Name="InspectorTitle" Text="Placa" FontSize="15" FontWeight="Bold" Foreground="#102C46" Margin="0,0,0,8"/>

                    <StackPanel x:Name="PlatePanel">
                      <TextBlock Text="Nome do layout" FontSize="11" Foreground="#526172"/>
                      <TextBox x:Name="PlateNameBox" TextChanged="PlateNameChanged"/>
                      <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Largura (mm)" FontSize="11" Foreground="#526172"/><TextBox x:Name="PlateWidthBox" LostFocus="NumericBoxCommit" KeyDown="NumericBoxKeyDown"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Altura (mm)" FontSize="11" Foreground="#526172"/><TextBox x:Name="PlateHeightBox" LostFocus="NumericBoxCommit" KeyDown="NumericBoxKeyDown"/></StackPanel>
                      </Grid>
                      <TextBlock Text="Cor de fundo da placa" FontSize="11" Foreground="#526172" Margin="0,6,0,0"/>
                      <StackPanel Orientation="Horizontal">
                        <Button x:Name="PlateColorButton" Tag="plate" Width="34" Height="24" Click="PickColorClick" ToolTip="Escolher cor"/>
                        <TextBox x:Name="PlateColorBox" Tag="plate" Width="100" LostFocus="ColorBoxCommit" KeyDown="ColorBoxKeyDown"/>
                      </StackPanel>
                      <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#6B7785" FontSize="11" Text="Clique em um elemento para editar. Arraste para mover, use as alças para redimensionar, setas para ajustar (Shift = 5 mm, Ctrl = 0,1 mm). Imagens ficam sempre ao fundo."/>
                    </StackPanel>

                    <StackPanel x:Name="ElementPanel" Visibility="Collapsed">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="X (mm)" FontSize="11" Foreground="#526172"/>
                        <TextBlock Grid.Column="1" Text="Y (mm)" FontSize="11" Foreground="#526172"/>
                        <TextBox x:Name="PosXBox" Grid.Row="1" LostFocus="NumericBoxCommit" KeyDown="NumericBoxKeyDown"/>
                        <TextBox x:Name="PosYBox" Grid.Row="1" Grid.Column="1" LostFocus="NumericBoxCommit" KeyDown="NumericBoxKeyDown"/>
                        <TextBlock Grid.Row="2" Text="Largura (mm)" FontSize="11" Foreground="#526172"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Altura (mm)" FontSize="11" Foreground="#526172"/>
                        <TextBox x:Name="WidthBox" Grid.Row="3" LostFocus="NumericBoxCommit" KeyDown="NumericBoxKeyDown"/>
                        <TextBox x:Name="HeightBox" Grid.Row="3" Grid.Column="1" LostFocus="NumericBoxCommit" KeyDown="NumericBoxKeyDown"/>
                      </Grid>

                      <StackPanel x:Name="TextPanel" Margin="0,8,0,0">
                        <TextBlock Text="Texto" FontSize="11" Foreground="#526172"/>
                        <TextBox x:Name="TextContentBox" TextChanged="TextContentChanged"/>
                        <TextBlock x:Name="TextHint" Foreground="#B42318" FontSize="11" TextWrapping="Wrap"/>
                        <ComboBox x:Name="FieldInsertBox" SelectionChanged="FieldInsertChanged" ToolTip="Insere um campo do produto na posição do cursor">
                          <ComboBoxItem Content="Inserir campo…" IsSelected="True"/>
                          <ComboBoxItem Content="Descrição" Tag="descricao"/>
                          <ComboBoxItem Content="Subdescrição" Tag="subdescricao"/>
                          <ComboBoxItem Content="Preço" Tag="preco"/>
                          <ComboBoxItem Content="Preço normal" Tag="preco_normal"/>
                          <ComboBoxItem Content="Validade" Tag="validade"/>
                          <ComboBoxItem Content="Validade (dd/MM)" Tag="validade_curta"/>
                          <ComboBoxItem Content="Início" Tag="inicio"/>
                          <ComboBoxItem Content="Início (dd/MM)" Tag="inicio_curto"/>
                          <ComboBoxItem Content="Condição" Tag="condicao"/>
                          <ComboBoxItem Content="Quantidade" Tag="quantidade"/>
                          <ComboBoxItem Content="Código" Tag="codigo"/>
                          <ComboBoxItem Content="Família" Tag="familia"/>
                          <ComboBoxItem Content="Descrição da família" Tag="descricao_familia"/>
                        </ComboBox>
                        <TextBlock Text="Tipo de letra" FontSize="11" Foreground="#526172" Margin="0,6,0,0"/>
                        <Button x:Name="FontButton" Click="InspectorFontClick" HorizontalContentAlignment="Stretch" ToolTip="Escolher o tipo de letra (lista com busca)">
                          <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="▾" Margin="6,0,0,0"/>
                            <TextBlock x:Name="FontButtonText" TextTrimming="CharacterEllipsis"/>
                          </DockPanel>
                        </Button>
                        <Grid Margin="0,6,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <StackPanel><TextBlock Text="Tamanho (pt)" FontSize="11" Foreground="#526172"/><TextBox x:Name="FontSizeBox" LostFocus="NumericBoxCommit" KeyDown="NumericBoxKeyDown"/></StackPanel>
                          <StackPanel Grid.Column="1"><TextBlock Text="Mínimo (pt)" FontSize="11" Foreground="#526172" ToolTip="Menor tamanho ao encolher para caber"/><TextBox x:Name="MinFontBox" LostFocus="NumericBoxCommit" KeyDown="NumericBoxKeyDown"/></StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                          <ToggleButton x:Name="BoldToggle" Content="N" FontWeight="Bold" Width="32" Height="26" Margin="3" Click="StyleToggleClick" ToolTip="Negrito"/>
                          <ToggleButton x:Name="ItalicToggle" Content="I" FontStyle="Italic" Width="32" Height="26" Margin="3" Click="StyleToggleClick" ToolTip="Itálico"/>
                          <Border Width="1" Background="#D5DBE3" Margin="6,3"/>
                          <ToggleButton x:Name="AlignLeftToggle" Content="⇤" Tag="Left" Width="32" Height="26" Margin="3" Click="AlignClick" ToolTip="Alinhar à esquerda"/>
                          <ToggleButton x:Name="AlignCenterToggle" Content="↔" Tag="Center" Width="32" Height="26" Margin="3" Click="AlignClick" ToolTip="Centralizar"/>
                          <ToggleButton x:Name="AlignRightToggle" Content="⇥" Tag="Right" Width="32" Height="26" Margin="3" Click="AlignClick" ToolTip="Alinhar à direita"/>
                        </StackPanel>
                        <TextBlock Text="Cor do texto" FontSize="11" Foreground="#526172" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="TextColorButton" Tag="text" Width="34" Height="24" Click="PickColorClick" ToolTip="Escolher cor"/>
                          <TextBox x:Name="TextColorBox" Tag="text" Width="100" LostFocus="ColorBoxCommit" KeyDown="ColorBoxKeyDown"/>
                        </StackPanel>
                      </StackPanel>

                      <StackPanel x:Name="ImagePanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Text="Imagem" FontSize="11" Foreground="#526172"/>
                        <ComboBox x:Name="ImageSourceBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ImageSourceChanged" ToolTip="Imagem fixa da biblioteca ou espaço para a imagem do produto/família"/>
                      </StackPanel>

                      <TextBlock Text="Fundo do elemento" FontSize="11" Foreground="#526172" Margin="0,8,0,0"/>
                      <StackPanel Orientation="Horizontal">
                        <Button x:Name="BackColorButton" Tag="back" Width="34" Height="24" Click="PickColorClick" ToolTip="Escolher cor"/>
                        <TextBox x:Name="BackColorBox" Tag="back" Width="100" LostFocus="ColorBoxCommit" KeyDown="ColorBoxKeyDown"/>
                        <Button Content="Sem fundo" Click="ClearBackColorClick"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#D5DBE3" ResizeDirection="Rows"/>

                <DockPanel Grid.Row="2" Margin="8,4,8,8">
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button Content="▲" Width="28" Click="LayerForwardClick" ToolTip="Trazer para frente"/>
                      <Button Content="▼" Width="28" Click="LayerBackwardClick" ToolTip="Enviar para trás"/>
                    </StackPanel>
                    <TextBlock Text="Camadas" FontWeight="SemiBold" Foreground="#102C46" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ListBox x:Name="LayersList" SelectionChanged="LayersSelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <DockPanel>
                          <TextBlock Text="{Binding Icon}" Width="22" FontWeight="Bold" Foreground="#0F766E"/>
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Grid>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="3. Lote e impressão">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top">
            <WrapPanel>
              <TextBlock Text="Layout:" VerticalAlignment="Center"/><ComboBox x:Name="BatchTemplateBox" DisplayMemberPath="Name" Width="210"/>
              <TextBlock Text="Data de venda:" VerticalAlignment="Center"/><DatePicker x:Name="SaleDate" Width="130" Margin="5"/>
              <ComboBox x:Name="PaperBox" SelectedIndex="0" Width="100"><ComboBoxItem Content="A4"/><ComboBoxItem Content="A3"/><ComboBoxItem Content="A5"/></ComboBox>
              <CheckBox x:Name="Landscape" Content="Paisagem" VerticalAlignment="Center" Margin="8"/>
              <TextBlock Text="Margens mm — Sup." VerticalAlignment="Center"/><TextBox x:Name="MarginTopText" Width="42" Text="7" ToolTip="Margem superior"/>
              <TextBlock Text="Dir." VerticalAlignment="Center"/><TextBox x:Name="MarginRightText" Width="42" Text="7" ToolTip="Margem direita"/>
              <TextBlock Text="Inf." VerticalAlignment="Center"/><TextBox x:Name="MarginBottomText" Width="42" Text="7" ToolTip="Margem inferior"/>
              <TextBlock Text="Esq." VerticalAlignment="Center"/><TextBox x:Name="MarginLeftText" Width="42" Text="7" ToolTip="Margem esquerda"/>
              <TextBlock Text="Espaço mm" VerticalAlignment="Center"/><TextBox x:Name="GapText" Width="50" Text="3"/>
              <CheckBox x:Name="CutMarks" Content="Contorno de corte" VerticalAlignment="Center" IsChecked="True" Margin="8"/>
            </WrapPanel>
            <WrapPanel>
              <Button Content="Gerar prévia" Click="GenerateClick"/><Button Content="Imprimir / PDF" Click="PrintClick"/>
              <Button Style="{StaticResource DangerButton}" Content="Remover destacados" Click="RemoveBatchItemClick" ToolTip="Remove as linhas destacadas do lote (Ctrl/Shift+clique para várias). Atalho: Delete"/><Button Content="Limpar lote" Click="ClearBatchClick"/>
            </WrapPanel>
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="BatchGrid" Margin="0,8,10,0" SelectionMode="Extended" PreviewKeyDown="BatchGridKeyDown">
              <DataGrid.Columns><DataGridTextColumn Header="Produto" Binding="{Binding Item.Description}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Cópias" Binding="{Binding Copies}" Width="65"/></DataGrid.Columns>
            </DataGrid>
            <DocumentViewer x:Name="DocumentPreview" Grid.Column="1"/>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="4. Histórico">
        <DockPanel Margin="12">
          <WrapPanel DockPanel.Dock="Top"><Button Content="Atualizar" Click="RefreshHistoryClick"/><Button Content="Carregar cópia do lote" Click="LoadHistoryClick"/><TextBlock Text="Reimpressões verificam a validade na nova data de venda." VerticalAlignment="Center" Margin="10"/></WrapPanel>
          <DataGrid x:Name="HistoryGrid" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns>
            <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt}" Width="230"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="180"/>
            <DataGridTextColumn Header="Layout" Binding="{Binding Batch.Template.Name}" Width="200"/><DataGridTextColumn Header="Detalhes" Binding="{Binding Detail}" Width="*"/>
          </DataGrid.Columns></DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="5. Gerenciar importações">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Gerenciar importações e limpar condições vencidas" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <WrapPanel>
              <Button Content="Atualizar lista" Click="RefreshImportsClick"/>
              <Button Style="{StaticResource DangerButton}" Content="Excluir importações selecionadas" Click="DeleteImportClick" ToolTip="Selecione uma ou mais linhas (Ctrl/Shift+clique). Atalho: Delete"/>
              <Button Content="Limpar ofertas e promoções vencidas" Click="CleanExpiredClick"/>
            </WrapPanel>
            <TextBlock Text="Um backup é criado antes de qualquer exclusão. Layouts e histórico são preservados. Importações antigas sem vínculos não podem ser excluídas individualmente." TextWrapping="Wrap" Margin="4,10" Foreground="#526172"/>
          </StackPanel>
          <DataGrid x:Name="ImportsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" PreviewKeyDown="ImportsGridKeyDown">
            <DataGrid.Resources>
              <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/></Style>
              <Style x:Key="RightText" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="TextAlignment" Value="Right"/></Style>
              <Style x:Key="ImportStatusText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="Foreground" Value="#067647"/>
                <Style.Triggers><DataTrigger Binding="{Binding Record.Managed}" Value="False"><Setter Property="Foreground" Value="#8A94A3"/></DataTrigger></Style.Triggers>
              </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Arquivo" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="Importado em" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="150" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="Itens" Binding="{Binding LinkedItems, StringFormat=N0}" Width="90" ElementStyle="{StaticResource RightText}"/>
              <DataGridTextColumn Header="Situação" Binding="{Binding Status}" SortMemberPath="Record.Managed" Width="190" ElementStyle="{StaticResource ImportStatusText}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="6. Imagens">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top">
            <WrapPanel>
              <Button Content="Adicionar imagens…" Click="AddImageClick"/>
              <Button Content="Importar pasta (nome = código do produto)" Click="ImportImageFolderClick" ToolTip="Ex.: 10486.jpg é vinculada ao produto 10486"/>
              <Button Content="Importar pasta (nome = código da família)" Click="ImportFamilyImageFolderClick" ToolTip="Ex.: 1124.jpg é vinculada à família 1124"/>
              <Button Style="{StaticResource DangerButton}" Content="Excluir selecionadas" Click="DeleteImageClick" ToolTip="Selecione uma ou mais imagens (Ctrl/Shift+clique). Atalho: Delete"/>
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#526172" Margin="4,10" Text="Cada imagem pode estar ligada ao produto, à família ou ao layout. Logos e fotos ficam guardados no banco de dados (reduzidas para até 1000 px). No layout (aba 2), use Adicionar imagem para inserir uma imagem do computador ou da biblioteca (fixa, como um logo), ou um espaço para a imagem do produto ou da família. Imagem do produto: botão Imagem do produto na aba 1, ou importe uma pasta com arquivos nomeados pelo código (ex.: 10486.jpg). Imagem da família: botão Imagem da família na aba 1, ou importe uma pasta nomeada pelo código da família. Dê dois cliques no nome para renomear."/>
          </StackPanel>
          <DataGrid x:Name="ImagesGrid" AutoGenerateColumns="False" SelectionMode="Extended" RowHeight="56" CellEditEnding="ImagesCellEditEnding" PreviewKeyDown="ImagesGridKeyDown">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Imagem" Width="90" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><Image Source="{Binding Thumbnail}" Height="48" Margin="4" Stretch="Uniform"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="90" IsReadOnly="True"/>
              <DataGridTextColumn Header="Produtos" Binding="{Binding Products}" Width="90" IsReadOnly="True"/>
              <DataGridTextColumn Header="Famílias" Binding="{Binding Families}" Width="90" IsReadOnly="True"/>
              <DataGridTextColumn Header="Layouts" Binding="{Binding Layouts}" Width="90" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
