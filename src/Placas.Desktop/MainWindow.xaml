<Window x:Class="Placas.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Placas Promocionais" Width="1380" Height="900" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#102C46" Padding="22,16">
      <DockPanel><TextBlock Foreground="#81E2D5" DockPanel.Dock="Right" Text="OFFLINE • Windows" VerticalAlignment="Center"/><TextBlock Text="Placas Promocionais" Foreground="White" FontSize="24" FontWeight="Bold"/></DockPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="Status" Text="Importe os arquivos do VR Master para começar."/></StatusBar>
    <TabControl x:Name="Tabs" Margin="14">
      <TabItem Header="1. Produtos e importação">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top">
            <WrapPanel>
              <Button x:Name="ImportButton" Content="Importar XLS / XLSX" Click="ImportClick"/>
              <Button Content="Cancelar leitura" Click="CancelImportClick"/>
              <Button Content="Relatório da importação" Click="ImportReportClick"/>
              <Button Content="Backup do banco" Click="BackupClick"/>
              <Button Content="Abrir pasta de dados" Click="OpenDataClick"/>
            </WrapPanel>
            <WrapPanel Margin="0,10,0,10">
              <TextBox x:Name="SearchText" Width="320" ToolTip="Código ou descrição" KeyDown="SearchKeyDown"/>
              <ComboBox x:Name="SourceFilter" Width="160" SelectedIndex="0"><ComboBoxItem Content="Todas as origens"/><ComboBoxItem Content="Catálogo"/><ComboBoxItem Content="Ofertas"/><ComboBoxItem Content="Promoções"/></ComboBox>
              <Button Content="Pesquisar" Click="SearchClick"/>
              <Button Content="Marcar exibidos" Click="SelectAllClick"/>
              <Button Content="Desmarcar" Click="ClearSelectionClick"/>
            </WrapPanel>
            <TextBlock Text="Busca limitada a 500 condições. Refine a pesquisa. Itens marcados são adicionados ao lote abaixo." Foreground="#526172" Margin="4,0,0,10"/>
          </StackPanel>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="Cópias por item:" VerticalAlignment="Center"/>
            <TextBox x:Name="CopiesText" Text="1" Width="55"/>
            <Button Content="Adicionar marcados ao lote" Click="AddToBatchClick"/>
            <Button Content="Confirmar regra da promoção destacada" Click="ConfirmRuleClick"/>
          </WrapPanel>
          <DataGrid x:Name="ProductsGrid" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="✓" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
              <DataGridTextColumn Header="Código" Binding="{Binding Item.DisplayCode}" Width="85" IsReadOnly="True"/>
              <DataGridTextColumn Header="Descrição" Binding="{Binding Item.Description}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="Preço" Binding="{Binding Item.Price, StringFormat=C2}" Width="90" IsReadOnly="True"/>
              <DataGridTextColumn Header="Normal" Binding="{Binding Item.NormalPrice, StringFormat=C2}" Width="90" IsReadOnly="True"/>
              <DataGridTextColumn Header="Origem" Binding="{Binding Origin}" Width="90" IsReadOnly="True"/>
              <DataGridTextColumn Header="Validade" Binding="{Binding Item.End}" Width="100" IsReadOnly="True"/>
              <DataGridTextColumn Header="Revisão" Binding="{Binding Review}" Width="130" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="2. Layouts salvos">
        <DockPanel Margin="12">
          <WrapPanel DockPanel.Dock="Top">
            <ComboBox x:Name="TemplatesBox" Width="240" DisplayMemberPath="Name" SelectionChanged="TemplateChanged"/>
            <Button Content="Novo" Click="NewTemplateClick"/><Button Content="Duplicar" Click="DuplicateTemplateClick"/>
            <Button Content="Salvar layout" Click="SaveTemplateClick"/><Button Content="Excluir" Click="DeleteTemplateClick"/>
            <Button Content="Exportar JSON" Click="ExportTemplateClick"/><Button Content="Importar JSON" Click="ImportTemplateClick"/>
          </WrapPanel>
          <StackPanel DockPanel.Dock="Top" x:Name="TemplateFields">
            <WrapPanel Margin="0,8">
              <TextBlock Text="Nome" VerticalAlignment="Center"/><TextBox Text="{Binding Name}" Width="230"/>
              <TextBlock Text="Largura mm" VerticalAlignment="Center"/><TextBox Text="{Binding WidthMm}" Width="65"/>
              <TextBlock Text="Altura mm" VerticalAlignment="Center"/><TextBox Text="{Binding HeightMm}" Width="65"/>
              <TextBlock Text="Fundo" VerticalAlignment="Center"/><TextBox Text="{Binding Background}" Width="110"/>
            </WrapPanel>
            <TextBlock Text="Campos: {descricao}  {codigo}  {preco}  {preco_normal}  {validade}  {condicao}" Margin="4,4,0,8"/>
            <TextBlock Text="Posições e dimensões em milímetros. Fontes em unidades WPF. Edite a tabela e clique em Atualizar prévia." Foreground="#526172" Margin="4,0,0,8"/>
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,12,0">
              <WrapPanel DockPanel.Dock="Bottom"><Button Content="Adicionar elemento" Click="AddElementClick"/><Button Content="Remover elemento" Click="RemoveElementClick"/><Button Content="Atualizar prévia" Click="TemplatePreviewClick"/></WrapPanel>
              <DataGrid x:Name="ElementsGrid" CanUserDeleteRows="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Texto / campo" Binding="{Binding Text}" Width="170"/>
                  <DataGridTextColumn Header="X" Binding="{Binding X}" Width="45"/><DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="45"/>
                  <DataGridTextColumn Header="Larg." Binding="{Binding Width}" Width="50"/><DataGridTextColumn Header="Alt." Binding="{Binding Height}" Width="50"/>
                  <DataGridTextColumn Header="Fonte" Binding="{Binding FontSize}" Width="50"/><DataGridTextColumn Header="Mín." Binding="{Binding MinFontSize}" Width="50"/>
                  <DataGridTextColumn Header="Cor" Binding="{Binding Foreground}" Width="90"/><DataGridTextColumn Header="Fundo" Binding="{Binding Background}" Width="100"/>
                  <DataGridCheckBoxColumn Header="Negrito" Binding="{Binding Bold}"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <Border Grid.Column="1" Background="#DCE1E7" Padding="20"><Viewbox Stretch="Uniform" x:Name="TemplatePreview"/></Border>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="3. Lote e impressão">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top">
            <WrapPanel>
              <TextBlock Text="Layout:" VerticalAlignment="Center"/><ComboBox x:Name="BatchTemplateBox" DisplayMemberPath="Name" Width="210"/>
              <TextBlock Text="Data de venda:" VerticalAlignment="Center"/><DatePicker x:Name="SaleDate" Width="130" Margin="5"/>
              <ComboBox x:Name="PaperBox" SelectedIndex="0" Width="100"><ComboBoxItem Content="A4"/><ComboBoxItem Content="A3"/><ComboBoxItem Content="A5"/></ComboBox>
              <CheckBox x:Name="Landscape" Content="Paisagem" VerticalAlignment="Center" Margin="8"/>
              <TextBlock Text="Margem mm" VerticalAlignment="Center"/><TextBox x:Name="MarginText" Width="50" Text="7"/>
              <TextBlock Text="Espaço mm" VerticalAlignment="Center"/><TextBox x:Name="GapText" Width="50" Text="3"/>
              <CheckBox x:Name="CutMarks" Content="Contorno de corte" VerticalAlignment="Center" IsChecked="True" Margin="8"/>
            </WrapPanel>
            <WrapPanel>
              <Button Content="Gerar prévia" Click="GenerateClick"/><Button Content="Imprimir / PDF" Click="PrintClick"/>
              <Button Content="Remover item destacado" Click="RemoveBatchItemClick"/><Button Content="Limpar lote" Click="ClearBatchClick"/>
            </WrapPanel>
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="BatchGrid" Margin="0,8,10,0" SelectionMode="Single">
              <DataGrid.Columns><DataGridTextColumn Header="Produto" Binding="{Binding Item.Description}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Cópias" Binding="{Binding Copies}" Width="65"/></DataGrid.Columns>
            </DataGrid>
            <DocumentViewer x:Name="DocumentPreview" Grid.Column="1"/>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="4. Histórico">
        <DockPanel Margin="12">
          <WrapPanel DockPanel.Dock="Top"><Button Content="Atualizar" Click="RefreshHistoryClick"/><Button Content="Carregar cópia do lote" Click="LoadHistoryClick"/><TextBlock Text="Reimpressões verificam a validade na nova data de venda." VerticalAlignment="Center" Margin="10"/></WrapPanel>
          <DataGrid x:Name="HistoryGrid" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns>
            <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt}" Width="230"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="180"/>
            <DataGridTextColumn Header="Layout" Binding="{Binding Batch.Template.Name}" Width="200"/><DataGridTextColumn Header="Detalhes" Binding="{Binding Detail}" Width="*"/>
          </DataGrid.Columns></DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
