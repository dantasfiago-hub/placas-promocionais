<Application x:Class="Placas.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#F3F5F8"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#E0F2F1"/><Setter Property="BorderBrush" Value="#9ACAC7"/><Setter Property="Foreground" Value="#123740"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0F766E"/><Setter Property="BorderBrush" Value="#0B5C56"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#FDECEC"/><Setter Property="BorderBrush" Value="#E8A8A8"/><Setter Property="Foreground" Value="#9B1C1C"/></Style>
    <Style x:Key="GroupLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#526172"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,0,8,0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="34"/><Setter Property="ColumnHeaderHeight" Value="36"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/><Setter Property="EnableRowVirtualization" Value="True"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="20,12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Application.Resources>
</Application>
